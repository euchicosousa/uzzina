{
  "functions": {
    "api/instagram-reference.ts": { "maxDuration": 180 },
    "api/instagram-publish.ts": { "maxDuration": 180 },
    "api/ai.ts": { "maxDuration": 180 },
    "api/strategy-operations.ts": { "maxDuration": 180 }
  },
  "rewrites": [
    {
      "source": "/api/planning-theme",
      "destination": "/api/ai?scope=planning-theme"
    },
    {
      "source": "/api/admin-accounts",
      "destination": "/api/admin?legacy=accounts"
    },
    {
      "source": "/api/admin-cleanup",
      "destination": "/api/admin?legacy=cleanup"
    },
    {
      "source": "/api/partner-delete",
      "destination": "/api/admin?legacy=cleanup&scope=partner-delete"
    },
    {
      "source": "/api/cloudinary-audit",
      "destination": "/api/admin?legacy=cleanup&scope=cloudinary-audit"
    },
    {
      "source": "/api/dash-auth",
      "destination": "/api/dash?scope=auth"
    },
    {
      "source": "/api/dash-data",
      "destination": "/api/dash?scope=data"
    },
    {
      "source": "/api/dash-action",
      "destination": "/api/dash?scope=action"
    },
    {
      "source": "/api/client-accounts",
      "destination": "/api/admin?legacy=accounts&scope=clients"
    },
    {
      "source": "/api/create-user",
      "destination": "/api/admin?legacy=accounts&scope=create-user"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
